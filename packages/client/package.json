{
  "name": "react-native-ota",
  "version": "0.0.0",
  "description": "Production-grade OTA updates for React Native (New Architecture)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "android",
    "ios",
    "react-native-ota.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "@rnota/protocol": "0.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "codegenConfig": {
    "name": "RNOtaSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.rnota"
    }
  }
}
