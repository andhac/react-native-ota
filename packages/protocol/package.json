{
  "name": "@rnota/protocol",
  "version": "0.0.0",
  "description": "Shared OTA protocol types: manifests, device API, release metadata",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  }
}
